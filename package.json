{
  "name": "@buslowicz/homebridge-huawei-fusionsolar-monitor",
  "version": "0.1.1",
  "description": "Read-only Huawei FusionSolar Northbound telemetry for Homebridge and Controller for HomeKit",
  "repository": {"type": "git", "url": "git+https://github.com/Buslowicz/homebridge-huawei-fusionsolar-monitor.git"},
  "homepage": "https://github.com/Buslowicz/homebridge-huawei-fusionsolar-monitor#readme",
  "license": "MIT",
  "publishConfig": {"registry": "https://npm.pkg.github.com"},
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": ["homebridge-plugin", "huawei", "fusionsolar", "sun2000", "solar"],
  "engines": {"node": "^22.12.0 || ^24.0.0 || ^26.0.0", "homebridge": "^1.11.4 || ^2.0.0"},
  "files": ["dist/", "config.schema.json", "README.md", "LICENSE", "docs/"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src .github/scripts",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm test",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.15",
    "eslint": "10.14.0",
    "homebridge": "2.5.0",
    "homebridge-v1": "npm:homebridge@1.11.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {"minimatch": "11.0.3"}
}
